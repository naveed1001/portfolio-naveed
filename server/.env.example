# Port the API listens on
PORT=5000

# Origin allowed by CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# MongoDB connection string.
# Leave this unset for local development and the server will start its own
# MongoDB instance automatically (no Docker, no system install required).
# Set it to an Atlas / managed cluster URI for production.
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio

# Cloudinary (only needed for the project image upload endpoint)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
